# Universal I/O for Web
#
# 値は入れずキー名だけを保つこと。ローカル開発では .env.local を作って埋める。
#
# このクライアントは AI プロバイダのキーを一切持たない。モデル呼び出しは
# すべて Gateway 経由で、ブラウザが持つ資格情報は Supabase セッションだけ。

# Gateway。既定は本番 (https://api.universal-io.com/api)。
# ローカルの Gateway を叩くときだけ、行頭の # を外して設定する。
# 空のまま置いても既定にフォールバックするが、行ごと無い方が意図が明確。
# NEXT_PUBLIC_GATEWAY_BASE_URL=http://localhost:7379/api

# Supabase（Gateway と同じプロジェクトを指すこと。anon key は公開前提の値）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
